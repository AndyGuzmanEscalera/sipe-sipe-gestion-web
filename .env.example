APP_ENV=development
APP_NAME=sipe-sipe-gestion-api
APP_VERSION=0.1.0
DATABASE_URL=postgresql+psycopg://sipe_app:sipe_dev_password@localhost:5433/gestion_sipe
POSTGRES_DB=gestion_sipe
POSTGRES_USER=sipe_app
POSTGRES_PASSWORD=sipe_dev_password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_ISSUER=sipe-sipe-gestion-api
JWT_AUDIENCE=sipe-sipe-gestion-admin
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
COOKIE_NAME=gestion_refresh_token
COOKIE_PATH=/api/admin/auth
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
CORS_ALLOW_ORIGINS=http://localhost:3000,http://localhost:5000,http://localhost:8080
CORS_ALLOW_CREDENTIALS=true
STORAGE_ROOT=storage
MAX_PDF_SIZE_MB=25
MAX_IMAGE_SIZE_MB=8
PUBLIC_BASE_URL=http://localhost:8001
